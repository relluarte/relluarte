{
  "version": 2,
  "name": "relluarte-gestao-static",
  "buildCommand": "./build.sh",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "functions": {},
  "build": null,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
